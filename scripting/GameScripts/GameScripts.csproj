<Project Sdk="Microsoft.NET.Sdk">

  <!-- Game-side scripts. Built next to Mage.Core.dll in <bin>/Scripts and loaded by the engine. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>GameScripts</AssemblyName>
    <RootNamespace>GameScripts</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RollForward>LatestMajor</RollForward>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <Copyright>Copyright (C) 2026 Maxdemyd0 and MAGE contributors</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- Private=false: Mage.Core.dll is provided by the engine's Scripts folder. -->
    <ProjectReference Include="..\Mage.Core\Mage.Core.csproj" Private="false" />
  </ItemGroup>

</Project>
