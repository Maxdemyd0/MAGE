//
// Edge-aware a-trous wavelet filter (SVGF). Run several times with step 1, 2, 4, 8, 16.
// 3x3 B-spline kernel per pass (5 passes cover a 63x63 footprint) with edge stopping on
// normals, view depth and luminance scaled by the local variance, so converged low-variance
// pixels are barely touched while fresh noise is smoothed. Reads one packed guide image per tap.
#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ImageSize();
    if (px.x >= size.x || px.y >= size.y) return;

    int step = pc.pass.x;
    int src = pc.pass.y;
    int dst = pc.pass.z;

    vec4 center = imageLoad(filterTemp[src], px);
    vec4 guide = imageLoad(gGuide, px);
    if (guide.w < 0.0) { // sky: nothing to denoise
        imageStore(filterTemp[dst], px, center);
        return;
    }
    float lum = Luminance(center.rgb);
    float sigmaL = ubo.params1.z * sqrt(max(center.a, 0.0)) + 1e-4;
    // Screen-space depth gradient (SVGF): on a plane seen at a grazing angle neighbouring
    // pixels differ a lot in depth, so the depth tolerance follows the local gradient.
    ivec2 px1 = min(px + ivec2(1, 0), size - 1), py1 = min(px + ivec2(0, 1), size - 1);
    vec4 gx = imageLoad(gGuide, px1), gy = imageLoad(gGuide, py1);
    vec2 dz = vec2(gx.w >= 0.0 ? gx.w - guide.w : 0.0, gy.w >= 0.0 ? gy.w - guide.w : 0.0);

    const float kernel[2] = float[2](0.5, 0.25);
    vec3 sumColor = center.rgb * 0.25;
    float sumVariance = center.a * 0.0625;
    float sumWeight = 0.25;
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            if (dx == 0 && dy == 0) continue;
            ivec2 q = px + ivec2(dx, dy) * step;
            if (q.x < 0 || q.y < 0 || q.x >= size.x || q.y >= size.y) continue;
            vec4 gq = imageLoad(gGuide, q);
            if (gq.w < 0.0) continue;
            vec4 sq = imageLoad(filterTemp[src], q);

            float wN = pow(max(dot(guide.xyz, gq.xyz), 0.0), 64.0);
            float expected = abs(dot(dz, vec2(dx, dy))) * float(step);
            float wZ = exp(-abs(guide.w - gq.w) / (expected + guide.w * 0.002 + 1e-3));
            float wL = exp(-abs(lum - Luminance(sq.rgb)) / sigmaL);
            float w = kernel[abs(dx)] * kernel[abs(dy)] * wN * wZ * wL;

            sumColor += sq.rgb * w;
            sumVariance += sq.a * w * w;
            sumWeight += w;
        }
    }
    imageStore(filterTemp[dst], px, vec4(sumColor / sumWeight, sumVariance / (sumWeight * sumWeight)));
}
