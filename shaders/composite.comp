// Remodulates the denoised illumination with albedo, adds primary emission and physically
// based aerial perspective (in-scattering + extinction of the atmosphere between camera and
// surface), writing scene-referred HDR radiance for exposure / bloom / tonemapping.
#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
#include "atmosphere.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ImageSize();
    if (px.x >= size.x || px.y >= size.y) return;

    uint cur = CurrentIndex();
    vec3 illum = imageLoad(filterTemp[pc.pass.y], px).rgb;
    vec4 guide = imageLoad(gGuide, px);
    if (guide.w >= 0.0) {
        // Despeckle: an isolated pixel far outside the range of its same-surface neighbours is
        // pulled back into that range (removes leftover dark/bright single-pixel outliers).
        float lo = 1e30, hi = 0.0;
        vec3 sum = vec3(0.0);
        float count = 0.0;
        for (int dy = -1; dy <= 1; ++dy)
            for (int dx = -1; dx <= 1; ++dx) {
                if (dx == 0 && dy == 0) continue;
                ivec2 q = clamp(px + ivec2(dx, dy), ivec2(0), size - 1);
                vec4 gq = imageLoad(gGuide, q);
                if (gq.w < 0.0 || dot(gq.xyz, guide.xyz) < 0.9) continue;
                vec3 c = imageLoad(filterTemp[pc.pass.y], q).rgb;
                float l = Luminance(c);
                lo = min(lo, l);
                hi = max(hi, l);
                sum += c;
                count += 1.0;
            }
        float lc = Luminance(illum);
        if (count >= 4.0 && (lc < lo * 0.6 || lc > hi * 1.6)) illum = sum / count;
    }
    vec3 albedo = imageLoad(gAlbedo, px).rgb;
    vec3 emission = imageLoad(gEmission, px).rgb;
    vec4 pos = imageLoad(gPos[cur], px);

    vec3 color = max(illum * albedo, vec3(0.0)) + emission;
    if (pos.w > 0.0 && (ubo.counts.z & CAMERA_AERIAL) != 0u) {
        vec3 toPoint = pos.xyz - ubo.cameraPos.xyz;
        float dist = length(toPoint);
        vec3 dir = toPoint / max(dist, 1e-4);
        ScatteringResult ap = IntegrateScattering(CameraAtmospherePos(), dir, ubo.sunDir.xyz, ubo.solarIrradiance.rgb, 8,
                                                  dist * 0.001, false, true, false);
        color = color * ap.transmittance + ap.luminance;
    }
    imageStore(hdrColor, px, vec4(color, 1.0));
}
