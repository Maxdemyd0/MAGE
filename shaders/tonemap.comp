// Camera output: exposure (EV100) -> bloom (lens glare) -> ACES filmic curve (RRT+ODT fit,
// Stephen Hill) -> sRGB transfer function. Writes the 8-bit display image.
#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

const mat3 ACES_INPUT = mat3(0.59719, 0.07600, 0.02840, 0.35458, 0.90834, 0.13383, 0.04823, 0.01566, 0.83777);
const mat3 ACES_OUTPUT = mat3(1.60475, -0.10208, -0.00327, -0.53108, 1.10813, -0.07276, -0.07367, -0.00605, 1.07602);

vec3 RrtOdtFit(vec3 v) {
    vec3 a = v * (v + 0.0245786) - 0.000090537;
    vec3 b = v * (0.983729 * v + 0.4329510) + 0.238081;
    return a / b;
}

vec3 LinearToSrgb(vec3 c) {
    return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), c));
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ImageSize();
    if (px.x >= size.x || px.y >= size.y) return;
    vec2 uv = (vec2(px) + 0.5) / vec2(size);

    vec3 hdr = imageLoad(hdrColor, px).rgb;
    if (ubo.counts.y > 0u) hdr = mix(hdr, texture(bloomTex[0], uv).rgb, ubo.camera.z);
    vec3 exposed = hdr * exposureData.exposure;
    vec3 mapped = clamp(ACES_OUTPUT * RrtOdtFit(ACES_INPUT * exposed), 0.0, 1.0);
    imageStore(outColor, px, vec4(LinearToSrgb(mapped), 1.0));
}
